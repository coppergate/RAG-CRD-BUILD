# ==============================================================================
# network.env — SINGLE SOURCE OF TRUTH for cluster network + registry addressing
#
# Flat-LAN design (matches kubernetes-setup/new-setup-external-gpu). Everything
# lives on the physical LAN 192.168.0.0/16 (gateway 192.168.0.1, DNS
# 192.168.1.210). The router's DHCP only hands out 192.168.0.x, so the cluster
# uses static 192.168.5.x addresses that never collide with the pool.
#
# WHO CONSUMES THIS:
#   - Install / maintenance shell scripts `source` this file and use the vars.
#   - scripts/render-manifests.sh reconciles the static YAML/JSON manifests
#     (which cannot read env vars at rest) to these values. Re-run it after any
#     change here:  bash scripts/render-manifests.sh
# ==============================================================================

# ── Host bootstrap registry (on hierophant, flat LAN 192.168.1.101) ──────────
# This is the registry prefix baked into infrastructure image references.
# Talos nodes also mirror all pulls here (see the talos registry patch).
REGISTRY_HOST="hierophant.hierocracy.home"
REGISTRY_PORT="5000"
REGISTRY_PREFIX="${REGISTRY_HOST}:${REGISTRY_PORT}"          # was 10.0.0.1:5000

# ── In-cluster registry (PureLB LoadBalancer) ────────────────────────────────
# Kept as a first-class registry; now carries an address from the new pool.
# Resolvable as registry.hierocracy.home / registry.container-registry.svc.
REGISTRY_LB_IP="192.168.5.201"                              # was 172.20.1.26
REGISTRY_LB_IP_LEGACY="172.20.1.26"                         # render search key

# ── Load balancer (PureLB) pool ──────────────────────────────────────────────
LB_POOL_SUBNET="192.168.5.0/24"                            # was 172.20.0.0/16
LB_POOL_RANGE="192.168.5.200-192.168.5.250"                # was 172.20.1.16-172.20.1.240
INGRESS_IP="192.168.5.200"                                 # Traefik / *.hierocracy.home wildcard

# ── Control plane / nodes (static, flat LAN 192.168.5.x) ─────────────────────
CP_VIP="192.168.5.10"                                      # was 10.0.0.15 ; k8s-api.hierocracy.home
CP_IPS="192.168.5.11 192.168.5.12 192.168.5.13"           # control-0/1/2 (was 10.0.0.200-202)
WORKER_IPS="192.168.5.21 192.168.5.22 192.168.5.23 192.168.5.24"  # worker-0..3 (was 10.0.0.110-113)
INFERENCE_IPS="192.168.5.31"                               # external GPU node (was 10.0.0.120)

# ── Host / DNS / gateway ─────────────────────────────────────────────────────
HIEROPHANT_IP="192.168.1.101"                             # was reachable via 10.0.0.1 (talos-nat gw)
DNS_SERVER="192.168.1.210"
LAN_GATEWAY="192.168.0.1"
DNS_SEARCH="hierocracy hierocracy.home"
